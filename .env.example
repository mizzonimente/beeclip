# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://clipmanager:clipmanager@localhost:5432/clipmanager?schema=public"

# ── Redis / job queue ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# ── Storage ────────────────────────────────────────────────────────────
# "local" oppure "s3"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="../../storage/local"
# Variabili usate solo se STORAGE_DRIVER=s3 (funziona anche con Cloudflare R2 / MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="clipmanager"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Provider AI (intercambiabili, vedi docs/02-architecture.md) ─────────
# "mock" | "openai"
TRANSCRIPTION_PROVIDER="mock"
OPENAI_API_KEY=""

# "mock" | "anthropic" | "openai"
ANALYSIS_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# ── Provider dati social/trend (opzionali, "mock" finché non collegati) ──
# "mock" | "licensed_provider"
SOCIAL_DATA_PROVIDER="mock"
SOCIAL_DATA_PROVIDER_API_KEY=""

# "mock" | "curated" | "licensed_provider" (default se vuoto: "curated", usa il feed di esempio aggiornabile a mano)
TREND_DATA_PROVIDER="mock"
TREND_DATA_PROVIDER_API_KEY=""
# Percorso del feed curato (JSON aggiornato a mano dal team); default = file di esempio incluso nel pacchetto ai-core
TREND_CURATED_FEED_PATH=""
TREND_CURATED_MAX_AGE_DAYS="14"

# ── App ────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
NODE_ENV="development"
