# Copia in .env.local (ignorato da git). Next.js carica .env.local in automatico,
# nessuna libreria dotenv necessaria (a differenza di apps/api e apps/worker).

# URL base dell'API Fastify (apps/api). NEXT_PUBLIC_* perché serve anche al
# codice eseguito nel browser (fetch dal client per upload, polling stato, ecc.).
NEXT_PUBLIC_API_URL="http://localhost:4000"
